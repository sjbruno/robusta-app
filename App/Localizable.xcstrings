    "Apagar esta agenda cancela as próximas doses dela.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting this schedule cancels its upcoming shots."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta agenda cancela as próximas doses dela."
          }
        }
      }
    },
    "Apagar esta agenda também remove a recorrência nativa do macOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting this schedule also removes the macOS native schedule."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar esta agenda também remove a recorrência nativa do macOS."
          }
        }
      }
    },
    "Apagar o bule cheio cancela as doses de início dele, e o Mac volta a dormir normalmente nesse horário.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting the full pot cancels its start shots, and your Mac goes back to sleeping normally at that time."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar o bule cheio cancela as doses de início dele, e o Mac volta a dormir normalmente nesse horário."
          }
        }
      }
    },
