    "**Bule cheio:** mantém o Mac acordado numa faixa de horário, na tomada.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Full pot:** keeps your Mac awake through a time window, on power."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bule cheio:** mantém o Mac acordado numa faixa de horário, na tomada."
          }
        }
      }
    },
    "**Nativo:** a recorrência do macOS. Funciona sem o Robusta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Native:** the macOS schedule. Works without Robusta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nativo:** a recorrência do macOS. Funciona sem o Robusta."
          }
        }
      }
    },
    "**Robusta:** agenda do app, renovada todo dia.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Robusta:** an app schedule, renewed every day."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "**Robusta:** agenda do app, renovada todo dia."
          }
        }
