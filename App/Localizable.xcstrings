            "value": "Esta dose passa a ser a recorrência nativa do macOS e continua valendo mesmo sem o Robusta."
          }
        }
      }
    },
    "Esta dose é de %@, não do Robusta. Cancelar pode atrapalhar quem o criou.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shot belongs to %@, not Robusta. Canceling it may break whatever created it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dose é de %@, não do Robusta. Cancelar pode atrapalhar quem o criou."
          }
        }
      }
    },
    "Esta recorrência nativa não foi criada pelo Robusta. Apagar pode atrapalhar quem a criou. Apagar mesmo assim?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This native schedule wasn't created by Robusta. Deleting it may break whatever created it. Delete anyway?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta recorrência nativa não foi criada pelo Robusta. Apagar pode atrapalhar quem a criou. Apagar mesmo assim?"
