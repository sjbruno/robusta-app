    "A recorrência nativa atual (%@ às %@) vira agenda do Robusta, sem deixar de acontecer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current native schedule (%@ at %@) becomes a Robusta schedule and keeps running."
          }
