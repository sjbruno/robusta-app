    "%@, suas agendas servem %lld doses. Na tomada, um bule cheio mantém o Mac acordado nesse período, em vez de acordá-lo tantas vezes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, your schedules pour %lld shots. On power, a full pot keeps your Mac awake through that period instead of waking it that many times."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, suas agendas servem %lld doses. Na tomada, um bule cheio mantém o Mac acordado nesse período, em vez de acordá-lo tantas vezes."
          }
        }
      }
    },
