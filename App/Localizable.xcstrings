        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A recorrência nativa atual (%@ às %@) vira agenda do Robusta, sem deixar de acontecer."
          }
        }
      }
    },
    "A recorrência nativa atual (%@) será convertida em agenda do Robusta, sem deixar de acontecer. Continuar?": {
